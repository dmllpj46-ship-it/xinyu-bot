<Slide style={{ width: 1280, height: 720, background: '#FBF7F2', padding: 0, position: 'relative', fontFamily: "'Noto Sans SC', system-ui, sans-serif" }}>

    {/* ── A 区 · 标题块 ── */}
    <Box style={{ position: 'absolute', left: 72, top: 46, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 4, height: 30, background: '#C0765C' }} />
        <Text style={{ fontSize: 36, fontWeight: 'bold', fontFamily: "'Noto Serif SC', Georgia, serif", color: '#2E2A27', lineHeight: 1.3 }}>
            三笔技术债，第一笔是结构性的
        </Text>
    </Box>

    {/* ── B 区上 · 债务权重（占 44%） ── */}
    <Box style={{ position: 'absolute', left: 72, top: 134, width: 1136, height: 240 }}>

        <Text style={{ fontSize: 12, letterSpacing: '0.16em', color: '#6E7C8C', marginBottom: 18 }}>DEBT WEIGHT · 按「会不会自己变好」排序</Text>

        {/* 第 1 笔 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 20 }}>
            <Text style={{ width: 250, fontSize: 19, fontWeight: 'bold', color: '#2E2A27' }}>双运行时手写镜像</Text>
            <Box style={{ width: 740, height: 52, background: 'rgba(192,118,92,0.80)' }} />
            <Box style={{ flex: 1 }} />
            <Text style={{ width: 110, textAlign: 'right', fontSize: 15, color: '#C0765C' }}>会持续恶化</Text>
        </Box>

        {/* 第 2 笔 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 20 }}>
            <Text style={{ width: 250, fontSize: 19, fontWeight: 'bold', color: '#2E2A27' }}>无状态失忆</Text>
            <Box style={{ width: 404, height: 52, background: 'rgba(110,124,140,0.34)' }} />
            <Box style={{ flex: 1 }} />
            <Text style={{ width: 110, textAlign: 'right', fontSize: 15, color: 'rgba(46,42,39,0.55)' }}>已接受</Text>
        </Box>

        {/* 第 3 笔 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ width: 250, fontSize: 19, fontWeight: 'bold', color: '#2E2A27' }}>块式流式</Text>
            <Box style={{ width: 218, height: 52, background: 'rgba(110,124,140,0.20)' }} />
            <Box style={{ flex: 1 }} />
            <Text style={{ width: 110, textAlign: 'right', fontSize: 15, color: 'rgba(46,42,39,0.55)' }}>已抹平</Text>
        </Box>

    </Box>

    {/* ── B 区下 · 三张不等宽卡片 ── */}
    <Box style={{ position: 'absolute', left: 72, top: 396, width: 1136, height: 244, flexDirection: 'row', gap: 18 }}>

        <Box style={{ width: 460, background: 'rgba(192,118,92,0.10)', padding: 24, justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 12, letterSpacing: '0.14em', color: '#C0765C', marginBottom: 10 }}>01 · STRUCTURAL</Text>
                <Text style={{ fontSize: 21, fontWeight: 'bold', fontFamily: "'Noto Serif SC', Georgia, serif", color: '#2E2A27', lineHeight: 1.4 }}>
                    改红线要改两遍
                </Text>
                <Text style={{ fontSize: 16, color: 'rgba(46,42,39,0.80)', lineHeight: 1.7, marginTop: 10 }}>
                    词表、分级、护栏、危机话术各有两份。规则越多越容易走样，且没有收敛点——只能靠两端跑同一批用例。
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#C0765C', marginTop: 12 }}>唯一解：共享层，或只保留一个运行时</Text>
        </Box>

        <Box style={{ width: 340, background: 'rgba(110,124,140,0.08)', padding: 24, justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 12, letterSpacing: '0.14em', color: '#6E7C8C', marginBottom: 10 }}>02 · ACCEPTED</Text>
                <Text style={{ fontSize: 21, fontWeight: 'bold', fontFamily: "'Noto Serif SC', Georgia, serif", color: '#2E2A27', lineHeight: 1.4 }}>
                    刷新即失忆
                </Text>
                <Text style={{ fontSize: 16, color: 'rgba(46,42,39,0.80)', lineHeight: 1.7, marginTop: 10 }}>
                    历史由浏览器持有，每轮重传 10 轮、单轮截 800 字。服务端零用户数据。
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#6E7C8C', marginTop: 12 }}>代价可量化</Text>
        </Box>

        <Box style={{ width: 300, background: 'rgba(110,124,140,0.05)', padding: 24, justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 12, letterSpacing: '0.14em', color: '#6E7C8C', marginBottom: 10 }}>03 · MITIGATED</Text>
                <Text style={{ fontSize: 21, fontWeight: 'bold', fontFamily: "'Noto Serif SC', Georgia, serif", color: '#2E2A27', lineHeight: 1.4 }}>
                    流式是块状的
                </Text>
                <Text style={{ fontSize: 16, color: 'rgba(46,42,39,0.80)', lineHeight: 1.7, marginTop: 10 }}>
                    Mercury 一次吐 2–4 块。前端按 12ms/字补间，后端不做假延迟。
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#6E7C8C', marginTop: 12 }}>纯前端问题</Text>
        </Box>

    </Box>

    <Text style={{ position: 'absolute', right: 72, bottom: 22, fontSize: 14, color: 'rgba(46,42,39,0.45)', letterSpacing: '0.04em' }}>
        09 / 10
    </Text>

</Slide>
